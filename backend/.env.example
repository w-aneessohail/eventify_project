# Server
NODE_ENV=development
PORT=5002

# PostgreSQL (required — no hardcoded fallbacks)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=eventify_db

# Auth (required — use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
SALT_ROUNDS=10

# CORS — comma-separated origins (required in production)
# Wildcards are rejected when credentials are enabled.
CORS_ORIGINS=http://localhost:5173

# Cookies
# Development: COOKIE_SECURE=false for http://localhost
# Production: COOKIE_SECURE=true behind HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Set true when running behind a reverse proxy (nginx, Railway, etc.)
TRUST_PROXY=false

# Request body limits (JSON and urlencoded)
BODY_LIMIT_JSON=1mb
BODY_LIMIT_URLENCODED=1mb

# Auth endpoint rate limiting (in-memory, single instance)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Email (SMTP) — optional for domain notifications; required for OTP auth emails
# Development: use Mailtrap (https://mailtrap.io) or Gmail app password
# If MAIL_USER / MAIL_PASS are unset, notifications are skipped (business actions still succeed)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mail_user
MAIL_PASS=your_mail_pass
MAIL_FROM="Eventify <no-reply@eventify.test>"

# Safepay (sandbox) — Safepay dashboard → Developer → API
# Public Key (starts with sec_) → SAFEPAY_PUBLIC_KEY
# Secret Key → SAFEPAY_SECRET_KEY
# Webhook shared secret (Developer → Webhooks → View Shared Secret) → SAFEPAY_WEBHOOK_SECRET
# Local dev: expose port 5002 via ngrok, then register:
#   POST https://<your-ngrok-host>/api/payments/webhook
# Subscribe to: payment.succeeded (and optionally payment.failed)
SAFEPAY_PUBLIC_KEY=your_safepay_public_key
SAFEPAY_SECRET_KEY=your_safepay_secret_key
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret
SAFEPAY_ENV=sandbox
FRONTEND_URL=http://localhost:5173
